{
  "name": "parent",
  "version": "0.0.1",
  "private": true,
  "homepage": "",
  "bugs": "",
  "author": {
    "name": "SBT R&D"
  },
  "workspaces": [
    "glsp-server",
    "glsp-client",
    "vscode/kdl-webview",
    "vscode/kdl-extension",
    "lsp-server"
  ],
  "scripts": {
    "all": "yarn clean && yarn install && yarn lint",
    "build": "yarn compile && yarn bundle",
    "bundle": "yarn glsp-server build && yarn webview build && yarn extension build && yarn lsp-server build",
    "clean": "lerna run clean",
    "compile": "tsc -b",
    "lint": "eslint --ext .ts,.tsx .",
    "lint:ci": "yarn lint --output-file eslint_report.json --format json",
    "package": "yarn extension package",
    "prepare": "yarn build",
    "watch": "concurrently --kill-others -n tsc,ext,gslp-server -c red,yellow,green \"tsc -b -w --preserveWatchOutput\" \"yarn -s extension watch:bundle\" \"yarn -s glsp-server watch:bundle\"",
    "webview": "yarn --cwd vscode/kdl-webview",
    "extension": "yarn --cwd vscode/kdl-extension",
    "glsp-client": "yarn --cwd glsp-client",
    "glsp-server": "yarn --cwd glsp-server",
    "lsp-server": "yarn --cwd lsp-server"
  },
  "resolutions": {
    "string-width": "4.2.3",
    "vscode-jsonrpc": "8.2.0"
  },
  "devDependencies": {
    "@eclipse-glsp/config": "2.3.0",
    "@types/node": "18.x",
    "concurrently": "^8.2.2",
    "lerna": "^8.1.7",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=16.11.0",
    "yarn": ">=1.7.0 <2.x.x"
  },
  "dependencies": {
    "@kubernetes/client-node": "^1.0.0",
    "yaml": "^2.7.0"
  }
}
