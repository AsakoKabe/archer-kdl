{
    "name": "kdl-language",
    "description": "KDL LSP server",
    "version": "0.0.1",
    "license": "AGPL-3.0",
    "files": [
        "out",
        "src"
    ],
    "type": "module",
    "scripts": {
        "build": "tsc -b tsconfig.src.json && node esbuild.mjs",
        "watch": "concurrently -n tsc,esbuild -c blue,yellow \"tsc -b tsconfig.src.json --watch\" \"node esbuild.mjs --watch\"",
        "lint": "eslint src --ext ts",
        "langium:generate": "langium generate",
        "langium:generate:production": "langium generate --mode=production",
        "langium:watch": "langium generate --watch",
        "vscode:prepublish": "npm run build && npm run lint",
        "test": "vitest run",
        "clean": "rimraf out tsconfig.tsbuildinfo"
    },
    "dependencies": {
        "@eclipse-glsp/layout-elk": "2.3.0",
        "@eclipse-glsp/server": "2.3.0",
        "@kdl/protocol": "0.0.0",
        "chevrotain": "~11.0.3",
        "langium": "^3.3.0",
        "p-debounce": "2.1.0",
        "prettier": "^3.1.0",
        "type-fest": "^4.18.2",
        "uuid": "~10.0.0",
        "vscode-languageclient": "9.0.1",
        "vscode-languageserver": "9.0.1",
        "vscode-languageserver-protocol": "^3.17.5",
        "vscode-languageserver-textdocument": "^1.0.11",
        "vscode-uri": "^3.0.2"
    },
    "devDependencies": {
        "@types/jest": "^29.5.6",
        "@types/node": "~16.18.41",
        "@types/vscode": "^1.95.0",
        "@typescript-eslint/eslint-plugin": "~6.4.1",
        "@typescript-eslint/parser": "~6.4.1",
        "@vscode/vsce": "^2.32.1-0",
        "cross-env": "~7.0.3",
        "esbuild": "~0.19.7",
        "eslint": "^8.17.0",
        "langium-cli": "^3.3.0",
        "ts-loader": "^9.4.2",
        "typescript": "~5.3.2"
    },
    "volta": {
        "node": "18.19.1",
        "npm": "10.2.4"
    },
    "displayName": "KDL Language Server",
    "engines": {
        "vscode": "^1.67.0",
        "node": ">=18.0.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "kdl",
                "aliases": [
                    "kdl",
                    "kdl"
                ],
                "extensions": [
                    ".kdl"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "kdl",
                "scopeName": "source.kdl",
                "path": "syntaxes/kdl.tmLanguage.json"
            }
        ]
    },
    "activationEvents": [
        "onLanguage:kdl"
    ],
    "main": "./out/extension/main.cjs"
}
