{
    "compilerOptions": {
        "target": "ES2017",
        "module": "Node16",
        "lib": [
            "ESNext"
        ],
        "sourceMap": true,
        "outDir": "out",
        "strict": true,
        "noUnusedLocals": true,
        "noImplicitReturns": true,
        "noImplicitOverride": true,
        "moduleResolution": "Node16",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "rootDir": ".",
        "noEmit": true,
        "strictPropertyInitialization": false,
    },
    "include": [
        "src/**/*.ts",
        "test/**/*.ts"
    ],
    "exclude": [
        "out",
        "node_modules"
    ],
    "extends": "../configs/base.tsconfig.json",
}
