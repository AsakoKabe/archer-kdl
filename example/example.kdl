kdlDiagram:
    id: example
    name: "example"
    model:
        clusters:
          - id: Cluster0
            name: "Cluster0"
          - id: ClusterNode1
            name: "default"
            services:
              - example.ServiceNode1
            pods:
              - example.PodNode0
          - id: ClusterNode2
            name: "rags"
            ingresses:
              - example.IngressNode0
            services:
              - example.ServiceNode0
              - example.ServiceNode2
            pods:
              - example.PodNode1
              - example.PodNode2
        ingresses:
          - id: IngressNode0
            name: "ingress"
            host: "rags.corernd.space"
            links:
              - example.ServiceNode0.roninPort0
              - example.ServiceNode2.uiPort0
        services:
          - id: ServiceNode0
            name: "ronin"
            ports:
              - id: roninPort0
                name: "ronin-service"
                number: 8080
            links:
              - example.PodNode1.ronin-6dbdd7fbfc-bzf56Port0
          - id: ServiceNode1
            name: "kubernetes"
            ports:
              - id: kubernetesPort0
                name: "https"
                number: 443
          - id: ServiceNode2
            name: "ui"
            ports:
              - id: uiPort0
                name: "ui-service"
                number: 3000
            links:
              - example.PodNode2.ui-86df54f46d-l7hkcPort0
        pods:
          - id: PodNode0
            name: "nginx-676b6c5bbc-kbtq6"
            containers:
              - example.ContainerNode0
          - id: PodNode1
            name: "ronin-6dbdd7fbfc-bzf56"
            containers:
              - example.ContainerNode1
            ports:
              - id: ronin-6dbdd7fbfc-bzf56Port0
                name: "http-port"
                number: 8080
          - id: PodNode2
            name: "ui-86df54f46d-l7hkc"
            containers:
              - example.ContainerNode2
            ports:
              - id: ui-86df54f46d-l7hkcPort0
                name: "http-port"
                number: 3000
        containers:
          - id: ContainerNode0
            name: "nginx"
          - id: ContainerNode1
            name: "ronin"
          - id: ContainerNode2
            name: "ui"
