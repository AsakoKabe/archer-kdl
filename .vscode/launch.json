{
  // Use IntelliSense to learn about possible Node.js debug attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run KDL Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "${workspaceFolder}/example",
        "--extensionDevelopmentPath=${workspaceFolder}/vscode/kdl-extension"
      ],
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/vscode/kdl-extension/dist/*.js",
        "${workspaceFolder}/node_modules/@eclipse-glsp/**/*.js"
      ],
      "sourceMapPathOverrides": {
        "webpack://vscode/(.+)": "${workspaceFolder}/vscode/kdl-extension/$1"
      },
      "env": {
        "KDL_GLSP_SERVER_PORT": "55801"
      }
    },
