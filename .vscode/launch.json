    {
      "name": "Attach to Language Server",
      "type": "node",
      "port": 6009,
      "request": "attach",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/vscode/kdl-extension/dist/**/*.js",
        "${workspaceFolder}/vscode/kdl-node_modules/langium/**/*.js"
      ]
    }
  ],
}